<header class="top-header">
    <div class="logo">
        <a href="/" style="text-decoration:none; color:inherit;">
            <h1><i class="fas fa-leaf"></i> AgriConnect</h1>
        </a>
    </div>

    <div class="search-bar">
        <i class="fas fa-search search-icon"></i>
        <input type="text" placeholder="Search products, seeds, equipments...">
        <button class="mic-btn"><i class="fas fa-microphone"></i></button>
    </div>

    <div class="header-actions">
        <% if (user) { %>
            <div class="action-item" title="<%= user.email %>">
                <i class="far fa-user"></i>
                <span><%= user.name.split(' ')[0] %></span>
            </div>
            <a href="/logout" class="action-item" style="text-decoration:none;">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        <% } else { %>
            <div class="action-item" onclick="openLoginModal()">
                <i class="far fa-user"></i>
                <span>Login</span>
            </div>
        <% } %>
        <div class="action-item">
            <i class="fas fa-shopping-cart"></i>
            <span>Cart</span>
        </div>
    </div>
</header>
