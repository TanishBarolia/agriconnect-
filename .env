# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file to git.

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session secret — any long random string, used to sign session cookies
SESSION_SECRET=replace_with_a_long_random_string

# data.gov.in — Agmarknet "Current Daily Price of Various Commodities" resource
# Get this from data.gov.in > My Account > API Keys (after signing up)
DATA_GOV_IN_API_KEY=your_data_gov_in_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# OpenWeatherMap — from openweathermap.org > My API Keys
OPENWEATHER_API_KEY=your_openweathermap_key_here

PORT=3001
